<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- KStorm Viewer; author: Kissmy Spicoli -->
<!-- KStorm Lighting pane "Depth of field" (KSFloaterLightingPane; design doc/kstorm2-lighting-UI-design.md section 10).
     Generated layout: rows are 10 px from the left, 280 px wide. -->
<floater can_close="true" header_height="38" can_dock="false" can_minimize="true" can_resize="false" height="290" layout="topleft" name="ks_lighting_dof" save_rect="true" single_instance="true" title="Depth of field" width="300">
  <slider can_edit_text="true" control_name="CameraAngle" decimal_digits="3" follows="left|top" height="16" increment="0.002" label="Zoom" label_width="120" layout="topleft" left="10" max_val="3.06" min_val="0.08" name="ks_zoom" show_text="true" text_width="56" top="6" width="280" />
  <check_box control_name="RenderDepthOfField" follows="left|top" height="16" label="Depth of field" layout="topleft" left="10" name="ks_dof" top="28" width="280" tool_tip="Blurs the view except at the camera focus." />
  <check_box control_name="FSFocusPointFollowsPointer" follows="left|top" height="16" label="Focus follows pointer" layout="topleft" left="10" name="ks_focus_follows" top="50" width="280" />
  <check_box control_name="FSFocusPointLocked" follows="left|top" height="16" label="Focus locked (Alt-Shift-X)" layout="topleft" left="10" name="ks_focus_locked" top="72" width="280" />
  <check_box control_name="FSFocusPointRender" follows="left|top" height="16" label="Show focus point" layout="topleft" left="10" name="ks_focus_show" top="94" width="280" />
  <text type="string" length="1" follows="left|top" height="16" layout="topleft" left="10" name="ks_dof_mode_label" top="119" width="116">DoF mode</text>
  <combo_box control_name="ASDepthOfFieldMode" follows="left|top" height="23" layout="topleft" left="130" name="ks_dof_mode" top="116" width="160" tool_tip="Same list as the AyaneStorm Depth of Field floater." />
  <slider can_edit_text="true" control_name="CameraFNumber" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="F-number" label_width="120" layout="topleft" left="10" max_val="22" min_val="0.01" name="ks_fnumber" show_text="true" text_width="56" top="144" width="280" />
  <slider can_edit_text="true" control_name="CameraFocalLength" decimal_digits="0" follows="left|top" height="16" increment="1" label="Focal length (mm)" label_width="120" layout="topleft" left="10" max_val="300" min_val="1" name="ks_focal" show_text="true" text_width="56" top="166" width="280" />
  <slider can_edit_text="true" control_name="CameraFieldOfView" decimal_digits="1" follows="left|top" height="16" increment="0.1" label="Field of view (deg)" label_width="120" layout="topleft" left="10" max_val="180" min_val="0.1" name="ks_fov" show_text="true" text_width="56" top="188" width="280" />
  <slider can_edit_text="true" control_name="CameraMaxCoF" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Max blur (CoC)" label_width="120" layout="topleft" left="10" max_val="150" min_val="0" name="ks_max_coc" show_text="true" text_width="56" top="210" width="280" />
  <slider can_edit_text="true" control_name="CameraDoFResScale" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="DoF resolution" label_width="120" layout="topleft" left="10" max_val="1" min_val="0" name="ks_dof_res" show_text="true" text_width="56" top="232" width="280" />
  <button follows="left|top" height="22" label="Depth of Field..." layout="topleft" left="10" name="ks_open_as_dof" top="254" width="140" tool_tip="Opens the AyaneStorm Depth of Field floater.">
    <button.commit_callback function="KS.CycleFloater" parameter="as_depth_of_field" />
  </button>
</floater>
