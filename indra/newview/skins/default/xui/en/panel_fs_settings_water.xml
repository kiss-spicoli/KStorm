<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
border="true"
follows="all"
height="390"
label="Water"
layout="topleft"
left="0"
name="panel_fs_settings_water"
top="0">
	<panel
	name="P_Wave_Fog"
	label="Fog"
	follows="left|top"
	layout="topleft"
	top_pad="1"
	left="3"
	width="292"
	height="65"
	border_visible="true"
	background_visible="true">

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<color_swatch
		can_apply_immediately="true"
		follows="left|top"
		height="40"
		label_height="0"
		layout="topleft"
		left="20"
		name="water_fog_color"
		tool_tip="Tints what is seen below the water surface."
		top_pad="5"
		width="90"/>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<texture_picker
		height="60"
		layout="topleft"
		left_pad="60"
		name="water_normal_map"
		tool_tip="Texture that gives the water its surface ripples."
		top_delta="0"
		width="40"/>

		<text
		follows="top|left"
		font="SansSerifSmall"
		layout="topleft"
		left="20"
		name="water_fog_label"
		top_pad="-16"
		width="110"
		tool_tip="Water Fog Color - This changes the color of the volume tint of the water, essentially defining the color of the water itself. If your water has no fog, it will appear crystal clear and colorless."
		word_wrap="true">
		Water Fog Color
		</text>

		<text
		follows="left|top|right"
		font="SansSerifSmall"
		layout="topleft"
		left_pad="30"
		name="normal_map_label"
		top_delta="0"
		tool_tip="Normal Map - Image used for determining reflections and refractions. Any texture may be used for this setting- but true normal maps work best."
		width="100">
		Normal Map
		</text>
	</panel>

	<panel
	name="P_Wave_Fog_2"
	label="Fog"
	follows="left|top"
	layout="topleft"
	top_pad="1"
	left="3"
	width="292"
	height="80"
	border_visible="true"
	background_visible="true">

		<text
		name="density_exponent_label"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="115">
		Density Exponent:
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		height="16"
		increment="0.01"
		initial_value="0"
		layout="topleft"
		min_val="0"
		max_val="100"
		name="water_fog_density"
		tool_tip="How quickly things below the water surface fade."
		left_pad="0"
		width="167"
		can_edit_text="true"/>

		<text
		name="underwater_modifier_label"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="115">
		Underwater Modifier:
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		height="16"
		increment="0.01"
		initial_value="0"
		layout="topleft"
		left_pad="0"
		min_val="0.0"
		max_val="20.0"
		name="water_underwater_mod"
		tool_tip="Multiplies the fog density while the camera is underwater."
		width="167"
		can_edit_text="true"/>

		<text
		name="FresnelScaleText"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="115">
		Fresel Scale:
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		height="16"
		increment="0.01"
		initial_value="0.7"
		layout="topleft"
		name="water_fresnel_scale"
		tool_tip="How much more the water reflects at grazing angles than looking straight down."
		left_pad="0"
		width="167"
		can_edit_text="true"/>

		<text
		name="FresnelOffsetText"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="115">
		Fresnel Offset:
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		increment="0.01"
		initial_value="0.7"
		height="16"
		layout="topleft"
		left_pad="0"
		name="water_fresnel_offset"
		tool_tip="Reflection added at every angle, looking straight down included."
		width="167"
		can_edit_text="true"/>
 	</panel>
 
	<panel
	name="P_Water_Wave"
	follows="left|top"
	label="Wave"
	layout="topleft"
	top_pad="1"
	left="3"
	width="292"
	height="180"
	border_visible="true"
	background_visible="true">

		<text
		name="large_wave_speed_label"
		follows="left|top"
		height="16"
		width="130"
		layout="topleft"
		top_pad="5"
		left="5">
		Large Wave Speed
		</text>

		<text
		name="small_wave_speed_label"
		follows="left|top"
		height="16"
		layout="topleft"
		top_delta="0"
		left_pad="10">
		Small Wave Speed
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<xy_vector
		follows="top|left"
		name="water_wave1_xy"
		tool_tip="Direction and speed of the large waves."
		width="130"
		height="75"
		visible="true"
		left="5"
		top_pad="0"
		min_val_x="-20"
		max_val_x="20"
		increment_x="0.01f"
		min_val_y="-20"
		max_val_y="20"
		increment_y="0.01f"
		arrow_color="white"/>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<xy_vector
		follows="top|left"
		name="water_wave2_xy"
		tool_tip="Direction and speed of the small waves."
		width="130"
		height="75"
		visible="true"
		left_pad="10"
		top_delta="0"
		min_val_x="-20"
		max_val_x="20"
		min_val_y="-20"
		max_val_y="20" 
		increment_x="0.01f"
		increment_y="0.01f"
		arrow_color="white"/>

		<text
		name="reflection_wavelet_scale_label"
		follows="left|top|right"
		height="16"
		layout="topleft"
		left="5"
		top_pad="5"
		width="215">
		Reflection Wavelet Scale
		</text>
		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		increment="0.01"
		height="16"
		initial_value="0.7"
		layout="topleft"
		label="X:"
		left="5"
		max_val="10"
		name="water_normal_scale_x"
		tool_tip="Ripple strength of the first wave layer."
		top_pad="0"
		width="282"
		can_edit_text="true"/>
		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		increment="0.01"
		initial_value="0.7"
		height="16"
		layout="topleft"
		left="5"
		max_val="10"
		name="water_normal_scale_y"
		tool_tip="Ripple strength of the second wave layer."
		top_pad="5"
		label="Y:"
		width="282"
		can_edit_text="true"/>
		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		decimal_digits="2"
		follows="left|top"
		increment="0.01"
		initial_value="0.7"
		height="16"
		layout="topleft"
		left="5"
		max_val="10"
		name="water_normal_scale_z"
		tool_tip="Ripple strength of the third wave layer."
		top_pad="5"
		label="Z:"
		width="282"
		can_edit_text="true"/>
	</panel>

	<panel
	name="P_Water_Reflection"
	label="Refraction"
	follows="left|top"
	layout="topleft"
	top_pad="1"
	left="3"
	width="292"
	height="60"
	border_visible="true"
	background_visible="true">
		<text
		name="refraction_scale_above_label"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="160">
		Refract Scale (Above):
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		control_name="water_scale_above"
		tool_tip="How much ripples bend what is seen through the water from above. Needs Transparent Water."
		decimal_digits="2"
		follows="left|top"
		increment="0.01"
		initial_value="0.1"
		height="16"
		layout="topleft"
		min_val="0"
		max_val="3"
		name="water_scale_above"
		left_pad="0"
		width="122"
		can_edit_text="true" />

		<text
		name="refraction_scale_below_label"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="160">
		Refract Scale (Below):
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		control_name="water_scale_below"
		tool_tip="How much ripples bend what is seen through the water from below. Needs Transparent Water."
		decimal_digits="2"
		follows="left|top"
		height="16"
		increment="0.01"
		initial_value="0"
		layout="topleft"
		left_pad="0"
		min_val="0"
		max_val="3"
		name="water_scale_below"
		width="122"
		can_edit_text="true"/>

		<text
		name="blur_multiplier_label"
		follows="left|top"
		height="15"
		layout="topleft"
		left="5"
		width="160">
		Blur Multiplier:
		</text>

		<!-- <KS:KS> tool_tip added </KS:KS> -->
		<slider
		control_name="water_blur_multip"
		tool_tip="How much the ripples blur the reflection."
		follows="left|top"
		height="16"
		increment="0.001"
		initial_value="0"
		layout="topleft"
		min_val="0"
		max_val="0.5"
		name="water_blur_multip"
		left_pad="0"
		width="122"
		can_edit_text="true"/>
	</panel>
</panel>
