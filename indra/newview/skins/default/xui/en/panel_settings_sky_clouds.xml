<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<panel
        border="true"
        follows="all"
        label="Clouds"
        layout="topleft"
        left="0"
        help_topic="land_general_tab"
        name="panel_settings_sky_clouds"
        top="0">
    <layout_stack 
            name="main_ls"
            follows="all"
            layout="topleft"
            left="5"
            top="5"
            right="-5"
            bottom="-5"
            orientation="hoizontal">
        <layout_panel
                name="left_lp"
                border="true"
                bevel_style="in"
                auto_resize="true"
                user_resize="false"
                visible="true"
                height="75">
            <text
                    name="cloud_coverage_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left ="5"
                    top="15"
                    width="100">
                Cloud Coverage:
            </text>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_pad="5"
                    min_val="0"
                    max_val="1"
                    name="cloud_coverage"
                    tool_tip="How much of the sky the clouds cover. Also removes sun and adds fill."
                    top_delta="0"
                    width="214"
                    can_edit_text="true"/>
            <text
                    name="cloud_scale_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left="5"
                    top_delta="15"
                    width="100">
                Cloud Scale:
            </text>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_pad="5"
                    min_val="0.01"
                    max_val="3"
                    name="cloud_scale"
                    tool_tip="Size of the cloud pattern."
                    top_delta="0"
                    width="214"
                    can_edit_text="true"/>
            <text
                    name="cloud_variance_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left="5"
                    top_delta="15"
                    width="100">
                Cloud Variance:
            </text>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_pad="5"
                    min_val="0"
                    max_val="1.0"
                    name="cloud_variance"
                    tool_tip="How much the cloud density varies across the sky."
                    top_delta="0"
                    width="214"
                    can_edit_text="true"/>
            <text
                    name="cloud_scroll_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left="5"
                    top_delta="25"
                    width="200">
                    Cloud Scroll:
            </text>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <xy_vector
            follows="left|top"
                    name="cloud_scroll_xy"
                    tool_tip="Direction and speed the clouds drift."
                    width="157"
                    height="178"
                    visible="true"
                    left="5"
                    top_delta="21"
                    min_val_x="-30"
                    max_val_x="30"
                    min_val_y="-30"
                    max_val_y="30" 
                    logarithmic="true"/>
                <text
                    name="cloud_image_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left_delta="180"
                    top_delta="-20"
                    width="200">
                    Cloud Image:
                </text>
                <!-- <KS:KS> tool_tip added </KS:KS> -->
                <texture_picker
                height="123"
                layout="topleft"
                left_delta="5"
                name="cloud_map"
                tool_tip="Noise texture the clouds are made from."
                top_pad="10"
                width="100"/>
                <text
                        name="cloud_color_label"
                        follows="left|top"
                        height="10"
                        layout="topleft"
                        left_delta="-5"
                        top_pad="5"
                        width="80">
                    Cloud Color:
                </text>
                <!-- <KS:KS> tool_tip added </KS:KS> -->
                <color_swatch
                        can_apply_immediately="true"
                        follows="left|top"
                        height="25"
                        label_height="0"
                        layout="topleft"
                        left_delta="5"
                        name="cloud_color"
                        tool_tip="Color of the clouds."
                        top_pad="5"
                        width="60" />                    
        </layout_panel>
                <layout_panel
                name="right_lp"
                border="true"
                bevel_style="in"
                auto_resize="true"
                user_resize="false"
                visible="true"
                height="75">
                <text
                name="cloud_density_label"
                follows="left|top"
                height="10"
                layout="topleft"
                    left_delta="15"
                    top_pad="15"
                    width="200">
                    Cloud Density:
                </text>
                <!-- <KS:KS> tool_tip added </KS:KS> -->
                <slider
                label="X"
                decimal_digits="2"
                follows="left|top"
                height="16"
                increment="0.01"
                initial_value="0"
                layout="topleft"
                left_delta="5"
                    min_val="0"
                    max_val="1"
                    name="cloud_density_x"
                    tool_tip="Moves the main cloud layer's thick areas east-west."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
                    <!-- <KS:KS> tool_tip added </KS:KS> -->
                    <slider
                    label="Y"
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_delta="0"
                    min_val="0"
                    max_val="1"
                    name="cloud_density_y"
                    tool_tip="Moves the main cloud layer's thick areas north-south."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    label="D"
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_delta="0"
                    min_val="0"
                    max_val="3"
                    name="cloud_density_d"
                    tool_tip="Density of the main cloud layer."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
            <text
                    name="cloud_detail_label"
                    follows="left|top"
                    height="10"
                    layout="topleft"
                    left_delta="-5"
                    top_delta="35"
                    width="200">
                Cloud Detail:
            </text>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    label="X"
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_delta="5"
                    min_val="0"
                    max_val="1"
                    name="cloud_detail_x"
                    tool_tip="Moves the detail layer's pattern east-west."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    label="Y"
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_delta="0"
                    min_val="0"
                    max_val="1"
                    name="cloud_detail_y"
                    tool_tip="Moves the detail layer's pattern north-south."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
            <!-- <KS:KS> tool_tip added </KS:KS> -->
            <slider
                    label="D"
                    decimal_digits="2"
                    follows="left|top"
                    height="16"
                    increment="0.01"
                    initial_value="0"
                    layout="topleft"
                    left_delta="0"
                    min_val="0"
                    max_val="1"
                    name="cloud_detail_d"
                    tool_tip="Density of the detail layer: how much fine structure the clouds show."
                    top_delta="20"
                    width="200"
                    can_edit_text="true"/>
        </layout_panel>
    </layout_stack>
</panel>                
