<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- AyaneStorm Viewer; author: chanayane@firestorm -->
<panel border="false" follows="all" height="580" layout="topleft" left="1" top="1" width="460" name="as_horizon_settings">
  <!-- Viewer-local analytic horizon light; all settings apply live. -->
  <text follows="left|top" font="SansSerifSmallBold" height="14" layout="topleft" left="15" name="horizon_label" top="10" width="300">Horizon scattering</text>
  <!-- <KS:KS> tool_tip was "Adds a viewer-local analytic sunset and sunrise band without modifying the active EEP." </KS:KS> -->
  <check_box control_name="ASHorizonScatteringEnabled" follows="left|top" height="16" label="Enable procedural horizon light" layout="topleft" left="15" name="horizon_enabled" top="34" width="410" tool_tip="Adds a viewer-local analytic sunset and sunrise band without modifying the active EEP. Every control below needs it, the cloud, water and sky haze ones included." />
  <text follows="left|top" height="16" layout="topleft" left="15" name="horizon_blend_label" top="64" width="190">Compositing</text>
  <combo_box control_name="ASHorizonScatteringBlendMode" follows="left|top" height="23" layout="topleft" left="205" name="horizon_blend" top="58" width="200" tool_tip="Use physical extinction plus in-scattering, add light, or replace only the generated horizon band.">
    <combo_box.item label="Additive (brighten EEP)" name="additive" value="0" />
    <combo_box.item label="Atmospheric blend" name="atmospheric" value="1" />
    <combo_box.item label="Replace EEP horizon" name="replace" value="2" />
  </combo_box>
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_blend" top="60" tool_tip="Reset compositing mode" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringBlendMode" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringStrength" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Light strength" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="horizon_strength" tool_tip="Brightness of the horizon light. Needs Enable procedural horizon light." show_text="true" text_width="50" top="92" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_strength" top="90" tool_tip="Reset light strength" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringStrength" /></button>
  <slider can_edit_text="true" control_name="ASHorizonScatteringOverrideOpacity" decimal_digits="2" enabled_control="ASHorizonScatteringBlendMode" follows="left|top" height="16" increment="0.05" label="Blend opacity" label_width="190" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="horizon_override_opacity" show_text="true" text_width="50" top="120" width="390" tool_tip="Strength of Atmospheric blend or Replace EEP horizon compositing. This setting does not apply to additive compositing." />
  <button enabled_control="ASHorizonScatteringBlendMode" follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_override_opacity" top="118" tool_tip="Reset blend opacity" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringOverrideOpacity" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringBandHeight" decimal_digits="1" follows="left|top" height="16" increment="0.5" label="Band height (degrees)" label_width="190" layout="topleft" left="15" max_val="35.0" min_val="1.0" name="horizon_band_height" tool_tip="Height of the full-strength horizon band, in degrees. Needs Enable procedural horizon light." show_text="true" text_width="50" top="148" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_band_height" top="146" tool_tip="Reset band height" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringBandHeight" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringBandSoftness" decimal_digits="1" follows="left|top" height="16" increment="0.5" label="Upper softness (degrees)" label_width="190" layout="topleft" left="15" max_val="20.0" min_val="0.5" name="horizon_band_softness" tool_tip="Fade above the band, in degrees. Needs Enable procedural horizon light." show_text="true" text_width="50" top="176" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_band_softness" top="174" tool_tip="Reset band softness" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringBandSoftness" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringRayleighStrength" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Rayleigh strength" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="horizon_rayleigh_strength" tool_tip="Broad, sky-colored (Rayleigh) part of the horizon light. Needs Enable procedural horizon light." show_text="true" text_width="50" top="204" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_rayleigh_strength" top="202" tool_tip="Reset Rayleigh strength" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringRayleighStrength" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringAerosolStrength" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Aerosol strength" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="horizon_aerosol_strength" tool_tip="Forward-scattered (aerosol, Mie) part of the horizon light, brightest toward the sun. Needs Enable procedural horizon light." show_text="true" text_width="50" top="232" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_aerosol_strength" top="230" tool_tip="Reset aerosol strength" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringAerosolStrength" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringMieAnisotropy" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Mie concentration" label_width="190" layout="topleft" left="15" max_val="0.95" min_val="0.0" name="horizon_mie_anisotropy" tool_tip="How tightly the aerosol light gathers toward the sun. Needs Enable procedural horizon light." show_text="true" text_width="50" top="260" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_mie_anisotropy" top="258" tool_tip="Reset Mie concentration" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringMieAnisotropy" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringAzimuthSpread" decimal_digits="0" follows="left|top" height="16" increment="1" label="Azimuth spread (degrees)" label_width="190" layout="topleft" left="15" max_val="180.0" min_val="10.0" name="horizon_azimuth_spread" tool_tip="Width, in degrees, of the horizon light around the sun's direction. Needs Enable procedural horizon light." show_text="true" text_width="50" top="288" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_azimuth_spread" top="286" tool_tip="Reset azimuth spread" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringAzimuthSpread" /></button>
  <text follows="left|top" height="16" layout="topleft" left="15" name="horizon_tint_label" top="322" width="190">Artistic tint</text>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <color_swatch border_color="0.45, 0.52, 0.61, 1" can_apply_immediately="true" color="1.0, 0.58, 0.22, 1.0" control_name="ASHorizonScatteringTint" follows="left|top" height="24" label="" label_height="0" layout="topleft" left="205" name="horizon_tint" tool_tip="Artistic tint multiplied into the horizon light. Needs Enable procedural horizon light." top="316" width="44" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="260" name="reset_horizon_tint" top="318" tool_tip="Reset artistic tint" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringTint" /></button>
  <!-- <KS:KS> tool_tip added </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringTintMix" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Tint mix" label_width="190" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="horizon_tint_mix" tool_tip="Mix between the live sunlight color (0) and Artistic tint (1). Needs Enable procedural horizon light." show_text="true" text_width="50" top="352" width="390" />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_tint_mix" top="350" tool_tip="Reset tint mix" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringTintMix" /></button>
  <!-- <KS:KS> tool_tip was "The layer fades in as the sun descends from this elevation." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringStartElevation" decimal_digits="1" follows="left|top" height="16" increment="0.5" label="Start elevation (degrees)" label_width="190" layout="topleft" left="15" max_val="45.0" min_val="0.0" name="horizon_start_elevation" show_text="true" text_width="50" top="380" width="390" tool_tip="The layer fades in as the sun descends from this elevation. Needs Enable procedural horizon light." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_start_elevation" top="378" tool_tip="Reset start elevation" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringStartElevation" /></button>
  <!-- <KS:KS> tool_tip was "The layer fades out when the sun reaches this elevation below the horizon." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringEndElevation" decimal_digits="1" follows="left|top" height="16" increment="0.5" label="End elevation (degrees)" label_width="190" layout="topleft" left="15" max_val="0.0" min_val="-30.0" name="horizon_end_elevation" show_text="true" text_width="50" top="408" width="390" tool_tip="The layer fades out when the sun reaches this elevation below the horizon. Needs Enable procedural horizon light." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_end_elevation" top="406" tool_tip="Reset end elevation" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringEndElevation" /></button>
  <!-- <KS:KS> tool_tip was "Strength of horizon-scattering colour applied to clouds near the horizon, independent of the horizon band itself." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringCloudStrength" decimal_digits="2" follows="left|top" height="16" increment="0.05" label="Cloud tint strength" label_width="190" layout="topleft" left="15" max_val="2.0" min_val="0.0" name="horizon_cloud_strength" show_text="true" text_width="50" top="436" width="390" tool_tip="Strength of horizon-scattering colour applied to clouds near the horizon, independent of the horizon band itself. Needs Enable procedural horizon light." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_cloud_strength" top="434" tool_tip="Reset cloud tint strength" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringCloudStrength" /></button>
  <!-- <KS:KS> tool_tip was "How far outward from the horizon the water fog band extends. 0 leaves water unchanged." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASWaterHorizonFogStrength" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Water horizon fog reach" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.0" name="horizon_water_fog" show_text="true" text_width="50" top="464" width="390" tool_tip="How far outward from the horizon the water fog band extends. 0 leaves water unchanged. Needs Enable procedural horizon light, and water near the horizon." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_water_fog" top="462" tool_tip="Reset water horizon fog reach" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASWaterHorizonFogStrength" /></button>
  <!-- <KS:KS> tool_tip was "Opacity/darkness of the water horizon fog blend toward the sky's haze color, independent of its reach. 0 makes the whole effect a no-op regardless of reach." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASWaterHorizonFogIntensity" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Water horizon fog intensity" label_width="190" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="horizon_water_fog_intensity" show_text="true" text_width="50" top="492" width="390" tool_tip="Opacity/darkness of the water horizon fog blend toward the sky's haze color, independent of its reach. 0 makes the whole effect a no-op regardless of reach. Needs Enable procedural horizon light; fades with the sun." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_water_fog_intensity" top="490" tool_tip="Reset water horizon fog intensity" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASWaterHorizonFogIntensity" /></button>
  <!-- <KS:KS> tool_tip was "How far outward from the horizon the sky darkens/desaturates toward a haze tone. 0 leaves the horizon band unchanged." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringSkyHazeStrength" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Sky horizon haze reach" label_width="190" layout="topleft" left="15" max_val="2.0" min_val="0.0" name="horizon_sky_haze" show_text="true" text_width="50" top="520" width="390" tool_tip="How far outward from the horizon the sky darkens/desaturates toward a haze tone. 0 leaves the horizon band unchanged. Needs Enable procedural horizon light." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_sky_haze" top="518" tool_tip="Reset sky horizon haze reach" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringSkyHazeStrength" /></button>
  <!-- <KS:KS> tool_tip was "Opacity/darkness of the sky horizon haze blend, independent of its reach. In Additive blend mode this locally darkens the horizon band as an exception to Additive's usual brighten-only behavior. 0 makes the whole effect a no-op regardless of reach." </KS:KS> -->
  <slider can_edit_text="true" control_name="ASHorizonScatteringSkyHazeIntensity" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Sky horizon haze intensity" label_width="190" layout="topleft" left="15" max_val="1.0" min_val="0.0" name="horizon_sky_haze_intensity" show_text="true" text_width="50" top="548" width="390" tool_tip="Opacity/darkness of the sky horizon haze blend, independent of its reach. In Additive blend mode this locally darkens the horizon band as an exception to Additive's usual brighten-only behavior. 0 makes the whole effect a no-op regardless of reach. Needs Enable procedural horizon light." />
  <button follows="left|top" height="20" image_overlay="Refresh_Off" layout="topleft" left="415" name="reset_horizon_sky_haze_intensity" top="546" tool_tip="Reset sky horizon haze intensity" width="20"><button.commit_callback function="ASHorizonScattering.ResetDefault" parameter="ASHorizonScatteringSkyHazeIntensity" /></button>

</panel>
