<floater can_close="true" header_height="38" can_dock="false" can_minimize="true" can_resize="false" height="288" layout="topleft" name="ks_lighting_shadows" save_rect="true" single_instance="true" title="Shadows" width="300">
  <slider can_edit_text="true" decimal_digits="2" follows="left|top" height="16" increment="0.01" label="Probe Fill Strength" label_width="120" layout="topleft" left="10" max_val="10" min_val="0.01" name="sky_probe_fill" show_text="true" text_width="56" top="6" width="280" tool_tip="&lt;1: fill from sky ambient (uniform). &gt;=1: fill from probes (bounce light, darker interiors). At a probe fill of 1 or more, probe irradiance fully replaces ambient wherever probes cover the surface. Reflections are unaffected. (KS Reference)" />
  <text type="string" length="1" follows="left|top" height="16" layout="topleft" left="10" name="ks_shadow_detail_label" top="31" width="116">Shadows</text>
  <combo_box control_name="RenderShadowDetail" follows="left|top" height="23" layout="topleft" left="130" name="ks_shadow_detail" top="28" width="160">
    <combo_box.item label="None" name="v0" value="0" />
    <combo_box.item label="Sun &amp; Moon" name="v1" value="1" />
    <combo_box.item label="Sun &amp; Moon + Projectors" name="v2" value="2" />
  </combo_box>
  <slider can_edit_text="true" control_name="RenderShadowResolutionScale" decimal_digits="1" follows="left|top" height="16" increment="0.5" label="Resolution" label_width="120" layout="topleft" left="10" max_val="5" min_val="0.5" name="ks_shadow_res" show_text="true" text_width="56" top="56" width="280" tool_tip="Shadow map size relative to the screen. (KS Reference)" />
  <slider can_edit_text="true" decimal_digits="3" follows="left|top" height="16" increment="0.025" label="Clarity" label_width="120" layout="topleft" left="10" max_val="10" min_val="0" name="ksv_RenderShadowSplitExponent_y" show_text="true" text_width="56" top="78" width="280" />
  <slider can_edit_text="true" control_name="RenderShadowBias" decimal_digits="6" follows="left|top" height="16" increment="1e-06" label="Bias" label_width="120" layout="topleft" left="10" max_val="0.001" min_val="-0.002" name="ks_shadow_bias" show_text="true" text_width="56" top="100" width="280" />
  <slider can_edit_text="true" control_name="RenderShadowFOVCutoff" decimal_digits="1" follows="left|top" height="16" increment="0.1" label="FOV cutoff" label_width="120" layout="topleft" left="10" max_val="100" min_val="0" name="ks_shadow_fov" show_text="true" text_width="56" top="122" width="280" />
