  <slider can_edit_text="true" decimal_digits="3" follows="left|top" height="16" increment="0.001" label="AO soften" label_width="120" layout="topleft" left="10" max_val="3" min_val="0.001" name="ksv_RenderShadowGaussian_y" show_text="true" text_width="56" top="258" width="280" />
