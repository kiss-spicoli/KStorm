  <check_box control_name="RenderDeferredSSAO" follows="left|top" height="16" label="Ambient occlusion" layout="topleft" left="10" name="ks_ao_quick" top="168" width="150" />
  <button follows="left|top" height="20" label="Settings..." layout="topleft" left="166" name="ks_ao_settings" top="166" width="66" tool_tip="Opens the Ambient pane (ambient light and ambient occlusion).">
    <button.commit_callback function="KS.CycleFloater" parameter="ks_lighting_ambient" />
