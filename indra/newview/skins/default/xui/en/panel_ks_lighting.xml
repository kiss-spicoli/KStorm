<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- KStorm Viewer; author: Kissmy Spicoli -->
<!-- KS tab of Environment Effects. Shown only while KSLightingControls is TRUE (KSPanelLighting). -->
<panel border="false" class="ks_lighting_panel" follows="all" height="380" layout="topleft" left="1" top="1" width="460" name="ks_lighting">
  <!-- Caches the current values when enabled, restores them when disabled (KSEnvironment). -->
  <check_box control_name="KSSetEnvironment" follows="left|top" height="16" label="Set KS environment" layout="topleft" left="15" name="ks_set_environment" top="10" width="410" tool_tip="Sets draw distance, avatar impostors, name tags, local light sort and Personal Lighting to the KS environment. Turning it off restores the previous values." />

  <text type="string" length="1" follows="left|top" height="16" layout="topleft" left="15" name="ks_shadow_detail_label" top="40" width="190">Shadows</text>
  <combo_box control_name="RenderShadowDetail" follows="left|top" height="23" layout="topleft" left="205" name="ks_shadow_detail" top="36" width="185">
    <combo_box.item label="None" name="0" value="0" />
    <combo_box.item label="Sun/Moon" name="1" value="1" />
    <combo_box.item label="Sun/Moon + Projectors" name="2" value="2" />
  </combo_box>

  <slider can_edit_text="true" control_name="RenderHDRSkySunlightScale" decimal_digits="1" follows="left|top" height="16" increment="0.1" initial_value="1.0" label="Sunlight scale" label_width="190" layout="topleft" left="15" max_val="100.0" min_val="0.0" name="ks_sunlight_scale" show_text="true" text_width="50" top="70" width="390" tool_tip="RenderHDRSkySunlightScale: sunlight scale when HDR is enabled." />
  <slider can_edit_text="true" control_name="RenderSkyAmbientScale" decimal_digits="1" follows="left|top" height="16" increment="0.1" initial_value="1.0" label="Ambient scale" label_width="190" layout="topleft" left="15" max_val="100.0" min_val="0.0" name="ks_ambient_scale" show_text="true" text_width="50" top="96" width="390" tool_tip="RenderSkyAmbientScale: sky ambient scale." />
  <!-- Not a setting: edits the Personal Lighting sky (same as its HDR Scale slider). -->
  <slider can_edit_text="true" decimal_digits="2" follows="left|top" height="16" increment="0.02" initial_value="0.1" label="HDR Scale" label_width="190" layout="topleft" left="15" max_val="20.0" min_val="0.0" name="ks_hdr_scale" show_text="true" text_width="50" top="122" width="390" tool_tip="Personal Lighting HDR Scale. Sets it using a local environment override." />
  <slider can_edit_text="true" control_name="RenderExposure" enabled_control="RenderDisableVintageMode" decimal_digits="1" follows="left|top" height="16" increment="0.1" initial_value="1.0" label="Exposure" label_width="190" layout="topleft" left="15" max_val="4.0" min_val="0.5" name="ks_exposure" show_text="true" text_width="50" top="148" width="390" tool_tip="RenderExposure, as in Preferences." />

  <!-- Copy of the Ambient occlusion section of Preferences > AyaneStorm > Rendering 2. -->
  <text
    type="string"
    length="1"
    follows="left|top"
    font="SansSerifSmallBold"
    height="14"
    layout="topleft"
    left="15"
    name="ambient_occlusion_section_label"
    top="180"
    width="200">
    Ambient occlusion
  </text>

  <check_box
    control_name="RenderDeferredSSAO"
    follows="left|top"
    height="16"
    label="Enable ambient occlusion"
    layout="topleft"
    left="15"
    mouse_opaque="true"
    name="render_ambient_occlusion"
    radio_style="false"
    top="201"
    width="250" />

  <text
    type="string"
    length="1"
    follows="left|top"
    height="16"
    layout="topleft"
    left="15"
    name="ambient_occlusion_technique_label"
    top="228"
    width="150">
    Technique:
  </text>
  <combo_box
    control_name="RenderAOTechnique"
    enabled_control="RenderDeferredSSAO"
    follows="left|top"
    height="23"
    layout="topleft"
    left="170"
    mouse_opaque="true"
    name="render_ambient_occlusion_technique"
    tool_tip="Choose the existing SSAO renderer or the new ground-truth ambient occlusion renderer."
    top="225"
    width="215">
    <combo_box.item label="Legacy SSAO" name="legacy_ssao" value="0" />
    <combo_box.item label="GTAO" name="gtao" value="1" />
  </combo_box>

  <check_box
    control_name="RenderAODebugWhite"
    enabled_control="RenderDeferredSSAO"
    follows="left|top"
    height="16"
    label="White-material AO comparison"
    layout="topleft"
    left="15"
    mouse_opaque="true"
    name="render_ambient_occlusion_debug_white"
    radio_style="false"
    tool_tip="Shows neutral white materials while retaining ambient occlusion and shadows for direct SSAO/GTAO comparison."
    top="259"
    width="300" />

  <!-- Narrower than in Preferences (left 395, width 370) to fit this tab. -->
  <text
    type="string"
    length="1"
    follows="left|top"
    height="32"
    layout="topleft"
    left="15"
    name="ambient_occlusion_tuning_help"
    top="286"
    width="290"
    word_wrap="true">
    AO quality and effect tuning are available in the Phototools panel.
  </text>
  <button
    follows="left|top"
    height="23"
    label="Open Phototools"
    layout="topleft"
    left="315"
    name="open_phototools"
    top="282"
    width="140">
    <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="phototools" />
  </button>

  <button
    follows="left|top"
    height="23"
    label="Depth of Field"
    layout="topleft"
    left="15"
    name="open_depth_of_field"
    top="330"
    width="140">
    <button.commit_callback function="Floater.ToggleOrBringToFront" parameter="as_depth_of_field" />
  </button>
</panel>
